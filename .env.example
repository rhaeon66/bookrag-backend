# ==========================================================
# BookRAG backend configuration (copy to .env and edit)
# Paths below are relative to this directory (where uvicorn/scripts run from).
# ==========================================================

# --- Backend / API ---
API_HOST=0.0.0.0
API_PORT=8000
# Origin(s) allowed to call this API from a browser -- set to wherever the
# bookrag-frontend app is running (comma-separated for more than one).
CORS_ORIGINS=http://localhost:3000
# Adds a `debug` block (retrieval trace + per-stage latency) to every /api/query
# response and enables DEBUG-level server logs. Can also be set per-request
# via {"debug": true} on POST /api/query without changing this global flag.
DEBUG_MODE=false

# --- PDF / Book ---
# Place your own copy of the book PDF here first (not included in this repo).
BOOK_PDF_PATH=data/raw/In_GOD's_Path.pdf
BOOK_TITLE=In God's Path

# --- Data locations ---
DATA_DIR=data
PROCESSED_DIR=data/processed

# --- Chunking (approx. tokens) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=75
CHUNK_MIN_SIZE=60

# --- Embeddings (sentence-transformers, local only, no external API calls) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Leave EMBEDDING_DEVICE/RERANK_DEVICE unset to auto-detect a GPU (CUDA or
# Apple MPS) and fall back to CPU; set explicitly (e.g. "cpu") to force it.
# EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=data/processed/embedding_cache
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:

# --- Vector store (ChromaDB) ---
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=bookrag

# --- Lexical retrieval (BM25) ---
BM25_INDEX_PATH=data/processed/bm25_index.pkl
BM25_TOP_K=15

# --- Retrieval ---
VECTOR_TOP_K=10
HYBRID_CANDIDATE_K=20
RRF_K=60

# --- Reranking (optional; set to false to skip the cross-encoder step) ---
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_DEVICE=cpu   # see EMBEDDING_DEVICE note above; auto-detects by default
RERANK_TOP_K=6

# --- Context builder ---
CONTEXT_MAX_TOKENS=2200
CONTEXT_MAX_CHUNKS=8
CONTEXT_NEIGHBOR_EXPANSION=true
CONTEXT_DEDUP_THRESHOLD=0.85
# Optional floor on cross-encoder rerank_score (raw logit, unbounded; positive
# is a good sign for ms-marco-MiniLM-style models). Chunks scoring below this
# are dropped instead of padding out RERANK_TOP_K with marginal matches. Only
# applies to chunks that were reranked, and only takes effect once you set it
# -- leave unset to keep today's behavior (always keep the top RERANK_TOP_K).
# CONTEXT_MIN_RERANK_SCORE=0

# --- LLM (local, via Ollama — no paid API key required) ---
# Only "ollama" is implemented today; kept configurable for future providers.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Ollama Cloud (free tier): OLLAMA_BASE_URL=https://ollama.com, LLM_MODEL=gpt-oss:20b,
# and create a key at https://ollama.com/settings/keys. Keep it secret.
# OLLAMA_API_KEY=
# Small, instruction-following model that works on ~8GB RAM / no dedicated GPU.
# Install Ollama (https://ollama.com) then: ollama pull qwen2.5:3b
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=120

# --- Query processing ---
QUERY_REWRITE_ENABLED=true

# --- Answer format ---
INSUFFICIENT_EVIDENCE_MESSAGE=I couldn't find enough information in the indexed book to answer this reliably.
